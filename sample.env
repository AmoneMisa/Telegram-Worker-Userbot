# Telegram API credentials from https://my.telegram.org/apps
# TG_SESSION grants full access to the account: keep worker.env private and
# chmod 600. `npm run login` can populate these values interactively.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Worker HTTP port.
PORT=4100

# Optional environment file override. By default the worker checks worker.env,
# .env, then flatfinder.env.
# TG_ENV_FILE=/path/to/worker.env

# Optional outbound proxy for hosts that cannot reach Telegram datacenters.
# SOCKS5: HOST + PORT, optionally USER + PASS.
# MTProxy: HOST + PORT + SECRET.
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_USER=
# TG_PROXY_PASS=
# TG_PROXY_SECRET=

# Persistent photo cache directory and retention window.
# TG_PHOTO_DIR=./photo-cache
TG_PHOTO_MAX_AGE_DAYS=21
