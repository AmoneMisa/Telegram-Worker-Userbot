# Template for worker.env. You normally don't fill this in by hand:
#
#   npm run login
#
# creates worker.env from this file, asks for anything blank and writes the
# session back into it. `npm start` then loads worker.env by itself (override
# the location with TG_ENV_FILE=/path/to.env; real env vars always win).
#
# TG_API_ID / TG_API_HASH: from https://my.telegram.org -> API development tools.
# TG_SESSION: full access to the account — keep this file chmod 600, never commit.
TG_API_ID=
TG_API_HASH=
TG_SESSION=
PORT=4100

# Optional outbound proxy, only if the host can't reach Telegram's data centers
# directly (a raw TCP connect to 149.154.x / 91.108.x times out). Leave unset for
# a direct connection.
#   SOCKS5:  TG_PROXY_HOST, TG_PROXY_PORT, [TG_PROXY_USER, TG_PROXY_PASS]
#   MTProxy: TG_PROXY_HOST, TG_PROXY_PORT, TG_PROXY_SECRET
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_SECRET=
