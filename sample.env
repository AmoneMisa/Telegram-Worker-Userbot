# Telegram API credentials from https://my.telegram.org/apps
# TG_SESSION grants full access to the account: keep .env private and chmod 600.
# `docker compose run --rm tg-worker npm run login` can populate these values interactively.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# Worker HTTP port.
PORT=4100

# Host address Docker publishes the worker on. Keep 127.0.0.1 when only local
# callers need it. For a fixed-IP remote consumer (for example Flat Finder on a
# second server), set this to this Telegram worker server's reachable IP and
# allow TCP/4100 in the host firewall only from the consumer server IP.
TG_BIND_IP=127.0.0.1

# Optional outbound proxy for hosts that cannot reach Telegram datacenters.
# SOCKS5: HOST + PORT, optionally USER + PASS.
# MTProxy: HOST + PORT + SECRET.
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_USER=
# TG_PROXY_PASS=
# TG_PROXY_SECRET=

# Persistent photo cache directory and retention window.
# TG_PHOTO_DIR=./photo-cache
TG_PHOTO_MAX_AGE_DAYS=21
