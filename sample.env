# Telegram MTProto worker — copy to worker.env and fill in.
#   cp sample.env worker.env && nano worker.env
#
# TG_API_ID / TG_API_HASH: from https://my.telegram.org -> API development tools.
# TG_SESSION: generate once with `npm run login` (needs API_ID/HASH set first).
TG_API_ID=
TG_API_HASH=
TG_SESSION=
PORT=4100

# Optional outbound proxy, only if the host can't reach Telegram's data centers
# directly (a raw TCP connect to 149.154.x / 91.108.x times out). Leave unset for
# a direct connection.
#   SOCKS5:  TG_PROXY_HOST, TG_PROXY_PORT, [TG_PROXY_USER, TG_PROXY_PASS]
#   MTProxy: TG_PROXY_HOST, TG_PROXY_PORT, TG_PROXY_SECRET
# TG_PROXY_HOST=
# TG_PROXY_PORT=
# TG_PROXY_SECRET=
